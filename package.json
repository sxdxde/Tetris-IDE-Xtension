{
  "name": "tetris",
  "displayName": "Tetris",
  "description": "Highlights all function declarations and calls in a single color so your code looks like Tetris blocks",
  "version": "0.1.0",
  "publisher": "your-publisher-name",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": ["Other"],
  "keywords": ["highlight", "functions", "color", "tetris"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension",
  "contributes": {
    "commands": [
      {
        "command": "tetris.goToCallers",
        "title": "Go to Callers",
        "category": "Tetris"
      },
      {
        "command": "tetris.goToDeclaration",
        "title": "Go to Declaration",
        "category": "Tetris"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "tetris.goToCallers",
          "when": "editorTextFocus",
          "group": "tetris@1"
        },
        {
          "command": "tetris.goToDeclaration",
          "when": "editorTextFocus",
          "group": "tetris@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.70.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0"
  }
}
